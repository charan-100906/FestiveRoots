# FestiveRoots Backend Environment Configuration Example
# Copy this file to .env for local development or set these variables in the Render dashboard

# Server port (automatically assigned by Render in production)
PORT=5000

# MongoDB Connection String:
# For Local Dev: mongodb://127.0.0.1:27017/festiveroots
# For Production: mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/festiveroots?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/festiveroots

# Secret key for signing JWT tokens (use a random string with 32+ characters in production)
JWT_SECRET=your_super_secret_jwt_key_here

# Frontend URL(s) allowed by CORS
# For Local Dev: http://localhost:5173
# For Production: https://festiveroots.vercel.app or comma-separated list of URLs
CLIENT_URL=http://localhost:5173

# Node runtime environment ('development' or 'production')
NODE_ENV=development
