# FestiveRoots Frontend Environment Configuration Example
# Copy to .env in client/ directory for local overrides, or set in Vercel project environment variables

# Backend Base API URL (without trailing slash or /api)
# For Local Dev: leave empty to use Vite's internal development proxy (/api -> http://localhost:5000)
# For Production on Vercel: set to your deployed Render backend URL, e.g. https://festiveroots-backend.onrender.com
VITE_API_URL=
